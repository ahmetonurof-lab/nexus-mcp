{
  "$schema": "https://app.kilo.ai/config.json",
  "commit_message": {
    "prompt": ""
  },
  "permission": {
    "edit": {
      "sonnet/**": "ask"
    }
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["C:\\Users\\Administrator\\AppData\\Local\\Programs\\codebase-memory-mcp\\codebase-memory-mcp.exe"],
      "enabled": true
    }
  }
}
